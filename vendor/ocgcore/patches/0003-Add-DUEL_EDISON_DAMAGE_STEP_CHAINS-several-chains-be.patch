From 6dd31599e82cee806e0bd935f8c82631491e3f58 Mon Sep 17 00:00:00 2001
From: edison-sim <noreply@anthropic.com>
Date: Fri, 20 Nov 2026 13:49:08 -0700
Subject: [PATCH] Add DUEL_EDISON_DAMAGE_STEP_CHAINS: several chains before
 damage calculation

Edison format, https://www.edisonformat.com/battle-phase.html :
"Multiple chains may be formed during Substeps 1-3. One 'manual' chain is
built during each of Substeps 4-7."

With DUEL_SINGLE_CHAIN_IN_DAMAGE_SUBSTEP the core allows one chain in every
Damage Step window. With this flag, further chains can be started before
damage calculation, whatever started the chain that just resolved (a
monster's Quick Effect such as "Honest" included: its ruling allows it in
Substeps 1, 3 and 4). Damage calculation and the steps after it keep one
chain each. No change when the flag is off.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 ocgapi_constants.h | 1 +
 processor.cpp      | 8 +++++++-
 2 files changed, 8 insertions(+), 1 deletion(-)

diff --git a/ocgapi_constants.h b/ocgapi_constants.h
index 5d193d3..8b0afb5 100644
--- a/ocgapi_constants.h
+++ b/ocgapi_constants.h
@@ -416,6 +416,7 @@
 // Edison format (TCG, April 2010) rules. Bits from 1 << 48 up, well clear of upstream's.
 #define DUEL_EDISON_IGNITION_PRIORITY 0x1000000000000
 #define DUEL_EDISON_LP_COST 0x2000000000000
+#define DUEL_EDISON_DAMAGE_STEP_CHAINS 0x4000000000000
 #define DUEL_MODE_SPEED        (DUEL_3_COLUMNS_FIELD | DUEL_NO_MAIN_PHASE_2 | DUEL_TRAP_MONSTERS_NOT_USE_ZONE | DUEL_TRIGGER_ONLY_IN_LOCATION)
 #define DUEL_MODE_RUSH         (DUEL_3_COLUMNS_FIELD | DUEL_NO_MAIN_PHASE_2 | DUEL_NO_STANDBY_PHASE | DUEL_1ST_TURN_DRAW | DUEL_INVERTED_QUICK_PRIORITY | DUEL_DRAW_UNTIL_5 | DUEL_NO_HAND_LIMIT | DUEL_UNLIMITED_SUMMONS | DUEL_TRAP_MONSTERS_NOT_USE_ZONE | DUEL_TRIGGER_ONLY_IN_LOCATION | DUEL_EXTRA_DECK_RITUAL)
 #define DUEL_MODE_MR1          (DUEL_OCG_OBSOLETE_IGNITION | DUEL_1ST_TURN_DRAW | DUEL_1_FACEUP_FIELD | DUEL_SPSUMMON_ONCE_OLD_NEGATE | DUEL_RETURN_TO_DECK_TRIGGERS | DUEL_CANNOT_SUMMON_OATH_OLD)
diff --git a/processor.cpp b/processor.cpp
index 8bee435..e1ec17e 100644
--- a/processor.cpp
+++ b/processor.cpp
@@ -4370,7 +4370,13 @@ bool field::process(Processors::SolveChain& arg) {
 		if(!arg.skip_trigger || !arg.skip_new) {
 			core.hint_timing[0] |= TIMING_CHAIN_END;
 			core.hint_timing[1] |= TIMING_CHAIN_END;
-			emplace_process<Processors::PointEvent>(arg.skip_trigger, arg.skip_freechain || arg.skip_new, arg.skip_new);
+			// Edison (TCG 2010) Damage Step, https://www.edisonformat.com/battle-phase.html : "Multiple chains may be
+			// formed during Substeps 1-3. One 'manual' chain is built during each of Substeps 4-7." Under
+			// DUEL_SINGLE_CHAIN_IN_DAMAGE_SUBSTEP the core allows one chain before damage calculation too. With this
+			// flag more can follow there, whatever started the last one; damage calculation keeps its single chain.
+			const bool more_chains = arg.skip_new && is_flag(DUEL_EDISON_DAMAGE_STEP_CHAINS) && infos.phase == PHASE_DAMAGE
+				&& !core.damage_calculated;
+			emplace_process<Processors::PointEvent>(arg.skip_trigger, arg.skip_freechain || (arg.skip_new && !more_chains), arg.skip_new);
 		}
 		returns.set<int32_t>(0, TRUE);
 		return TRUE;
-- 
2.40.0

